# 站點設定
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase（在 Supabase Dashboard > Project Settings > API 取得）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Database password（Dashboard → Project Settings → Database），供 npm run db:apply 套用 migration
PASSWORD=

# POE AI（https://poe.com/api_key 取得）
POE_API_KEY=
POE_BASE_URL=https://api.poe.com/v1

# Vercel Cron：喚醒 Supabase（見 vercel.json，部署後在 Vercel 設定隨機字串）
CRON_SECRET=

# LINE Login（在 LINE Developers Console 取得，僅供 scripts/setup-line-provider.mjs 使用）
LINE_CHANNEL_ID=2010164392
LINE_CHANNEL_SECRET=
